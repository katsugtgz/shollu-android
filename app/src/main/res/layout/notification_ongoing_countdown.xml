<?xml version="1.0" encoding="utf-8"?>
<!--
    Big-countdown ongoing notification (RemoteViews). On Android 12+ the system
    sanitizes custom notifications to a standard template chrome — only the
    content below is ours. The Chronometer self-ticks down to its base, so the
    service keeps its prayer-boundary update cadence (no 1 Hz work added).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/prayer_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/notification_countdown_secondary"
        android:singleLine="true"
        android:ellipsize="end" />

    <Chronometer
        android:id="@+id/countdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="@color/notification_countdown_primary"
        android:countDown="true"
        android:singleLine="true" />
</LinearLayout>
